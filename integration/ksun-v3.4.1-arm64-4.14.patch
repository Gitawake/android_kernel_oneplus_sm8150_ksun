diff --git a/kernel/hook/syscall_hook.h b/kernel/hook/syscall_hook.h
index d4921bf..46c0d12 100644
--- a/kernel/hook/syscall_hook.h
+++ b/kernel/hook/syscall_hook.h
@@ -1,6 +1,19 @@
 #ifndef __KSU_H_KSU_SYSCALL_HOOK
 #define __KSU_H_KSU_SYSCALL_HOOK
 #include <asm/syscall.h>
+#include <linux/version.h>
+#include <linux/sched.h>
+
+#if defined(__aarch64__) && LINUX_VERSION_CODE < KERNEL_VERSION(4, 17, 0)
+#define KSU_NATIVE_ARM64_SYSCALL 1
+typedef long (*syscall_fn_t)(unsigned long, unsigned long, unsigned long,
+                             unsigned long, unsigned long, unsigned long);
+#define KSU_SYSCALL_ENTRY_ARGS unsigned long a0, unsigned long a1, unsigned long a2, unsigned long a3, unsigned long a4, unsigned long a5
+#define KSU_SYSCALL_ENTRY_REGS const struct pt_regs *regs = task_pt_regs(current)
+#else
+#define KSU_SYSCALL_ENTRY_ARGS const struct pt_regs *regs
+#define KSU_SYSCALL_ENTRY_REGS
+#endif
 
 #if defined(__x86_64__)
 typedef sys_call_ptr_t syscall_fn_t;
@@ -8,6 +21,16 @@ typedef sys_call_ptr_t syscall_fn_t;
 typedef long (*syscall_fn_t)(const struct pt_regs *);
 #endif
 
+static inline long ksu_invoke_syscall(syscall_fn_t fn, const struct pt_regs *regs)
+{
+#ifdef KSU_NATIVE_ARM64_SYSCALL
+    return fn(regs->regs[0], regs->regs[1], regs->regs[2],
+              regs->regs[3], regs->regs[4], regs->regs[5]);
+#else
+    return fn(regs);
+#endif
+}
+
 extern syscall_fn_t *ksu_syscall_table;
 
 // Dispatcher slot number in syscall table
