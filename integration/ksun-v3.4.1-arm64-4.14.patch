--- /dev/null
+++ b/kernel/include/los_414_compat.h
@@ -0,0 +1,15 @@
+#ifndef KSU_LOS_414_COMPAT_H
+#define KSU_LOS_414_COMPAT_H
+#include <linux/version.h>
+#if LINUX_VERSION_CODE < KERNEL_VERSION(4, 17, 0)
+#include <linux/uaccess.h>
+#include <linux/task_work.h>
+/* This LOS tree has the pre-5.7 bool task_work notification API. */
+#define TWA_RESUME true
+/* These helpers were renamed in upstream 5.8; preserve nofault semantics. */
+#define copy_from_user_nofault probe_user_read
+#define copy_to_user_nofault probe_user_write
+#define copy_from_kernel_nofault probe_kernel_read
+#define copy_to_kernel_nofault probe_kernel_write
+#endif
+#endif
