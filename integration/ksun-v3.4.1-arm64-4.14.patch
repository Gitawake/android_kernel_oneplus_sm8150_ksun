+static struct file *ksu_alloc_file_pseudo_414(struct inode *inode,
+    struct vfsmount *mnt, const char *name, int flags,
+    const struct file_operations *fops)
+{
+    struct path path;
+    struct file *file;
+    const struct qstr qname = QSTR_INIT(name, strlen(name));
+    path.dentry = d_alloc_pseudo(mnt->mnt_sb, &qname);
